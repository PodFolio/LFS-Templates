struct GeometryInfo{
    word    NumVertex;      //2
    word    NumFaces;       //2
    uint    CountNotice;
    Vec3R   rotate;
    word    Zero;
    Vector3 pos;            // position
};



struct ObjectName // 16 byte
{

    char Name[16];
    byte R; // Red
    byte G; // Green
    byte B; // Blue
    byte X; // N/A
    //word MaterialID;
};

struct Vertex // size = 16 byte
{
    int id_material;
    int X; // float = 4 byte
    int Y;
    int Z;
};

struct Faces // 12 bytes
{
    byte MirrorState; // SEE BELOW MIRROR_STATE
    byte LayoutID; // Car Layout ID
    byte MapID;
    byte NCLevel;
    byte LodID;
    byte Smooth; // 
    u_word Ind1;
    u_word Ind2;
    u_word Ind3;
};

enum MIRROR_STATE
{
    MIRROR_OFF = 0,
    MIRROR_ON = 1,
    OLOLO_2 = 2,
    GLASS = 4,
    OLOLO_8 = 8,
    MIRROR_FIX = 16
};

struct Texture // 20 byte
{
    int  Flag; // 1 - locate in /skins_dds/CAR_DEFAULT.dds
    char Name[20]<comment = "filename in /data/dds texture name">;
};

