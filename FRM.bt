enum <byte> dierctions  {
    across = 0,
    along = 1,
    cross = 3
};
enum <byte> pointtype  {
    vertex = 0,
    lowerpivot = 1,
    upperpivot = 2,
    thrustbearing = 3
};
enum <byte> visibility  {
    notvisible = 0,
    visible = 1
};


struct POINTS
{
        hfloat ann[6];
        float ann1;
        byte ann1;
        byte ann1;
        pointtype type;
        byte ann1;
};
struct TUBE
{
        byte un1;
        byte un2;
        byte direction;
        byte direction2;
        float TUBEmass;
        visibility type;
        byte un6;
        byte un6;
        byte un6;
       
};
 
    

struct FILE{
    struct HEADER {
        char head[6] <bgcolor=0x67D8D8>;
        byte empty;
        byte version <bgcolor=0x9F9FFE ,format=hex>;


    } header;
    int pointCount;
    POINTS unn[pointCount];
    int tubesCount;
    TUBE unn2[tubesCount];

}file;