Header head;
struct {
Headr he;
    Child Chld  <bgcolor=cRed>;

    struct  LODInfo lodinf[Chld.LODsCount];

    struct GeometryInfo Geometry;
    struct Vertex Vert[Geometry.NumVertex];
    struct Faces  Face[Geometry.NumFaces];
    
    int    countPage;
    struct Texture Textures[countPage];

    int TextureDescriptionsCount <bgcolor=cYellow>;
    struct CutOut TextureDescriptionss[TextureDescriptionsCount];

    
    ushort MaterialCount <bgcolor=cYellow>;
    ushort u2;
    struct Map Materials[MaterialCount];    


    if(Chld.Type == 0) {
            struct {
            char name[8];
            } layouts[16];
        
            byte ZERO[128];
        }
}  Suit[14] <optimize=false>;
