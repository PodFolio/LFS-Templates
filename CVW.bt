string angle (float &i) {
    string ang;
    SPrintf(ang, "%0.2f",((float)i *57.29577));
    return ang;
}
string radius (float &i) {
    string ra;
    SPrintf(ra, "%0.3f",(((float)i/100)/2));
    return ra;
}
struct Header
{
    char    FileType[7];   
    byte    Na;            
};

enum <byte> DRAW{
    none = 0,
    wheels = 1,
    body = 2
};
enum <byte> CLOCKS{
    off = 0,
    real = 1,
    virtual = 2,
    all = 3
};
enum <byte> MIRROR{
    off_ = 0,
    real_ = 1,
    virtual_ = 2
};
enum <byte> LOOK{
    joystick_ = 0,
    axis = 1,
    steer = 2,
    mouseX = 3,
    mouseXY = 4
};

