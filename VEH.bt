struct EngFinal{
    local byte version = 0;
    int tbt;
    if((tbt & 8)!=0){
        byte engVersion <comment = "should be higher than 16">;
        version = engVersion;
        byte zero;
        byte z;
        byte ev;
        if(ev !=0){
            float redLine;
            float MaxPowerEv;
            float MaxTorqueEv;
            return;
        }
    }
    float engineSize;
    byte Cylinders;
    byte EngLayout;
    short unk;
    float maxTurboBoost;
    if(12 < version){
        float maxTurboMultiplier;
    }
    float MaxTorqueMulti;
    if(version < 14){
        if((tbt & 4) != 0){
            float torqueMulti;
            float redLine;
        }
    }else{
        float TorquesMulti;
        float flo0;
        float redLine;
    }
    float camTime;
    if(version<2){
        int emtpy;
    }
    if(version < 16){

    }else{
        float ResistanceMulti <comment = pots>;
        float InertiaMult<comment = pots>;
        float Idle;
    }
};

