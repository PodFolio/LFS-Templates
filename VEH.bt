#include "SET_veh.bt" 
typedef unsigned char byte;
typedef signed short word;
typedef unsigned short u_word;
typedef unsigned int u_int;


//local int i; 
string pots (float &i) {
    string pot;
    SPrintf(pot, "%0.14f",((float)i));
    return pot;
}

string angle (ubyte &i) {
    string ang;
    SPrintf(ang, "%0.3f",((float)i *5));
    return ang;
}
string fangle (float &i) {
    string ang;
    SPrintf(ang, "%0.3f",(((float)i *100)/1.7453f));
    return ang;
}
string radius (ubyte &i) {
    string ra;
    SPrintf(ra, "%0.3f",(((float)i/100)/2));
    return ra;
}
string fradius (float &i) {
    string ra;
    SPrintf(ra, "%0.3f",(((float)i+0.313)*100));
    return ra;
}
string fradius2 (float &i) {
    string ra;
    SPrintf(ra, "%0.3f",(((float)i/100)/2));
    return ra;
}
string minusto (ubyte &i) {
    string hun;
    SPrintf(hun, "%0.2f",(((float)i-100) /100));
    return hun;
}
string sto (float &i) {
    string hun;
    SPrintf(hun, "%0.2f",((float)i /100));
    return hun;
}
string sto2 (float &i) {
    string hun;
    SPrintf(hun, "%0.2f",((float)i *1000));
    return hun;
}
string stoR (float &i) {
    string hun;
    SPrintf(hun, "%0.2f =(RimDiamweter*100)/1.27",(((float)i *100)/1.27f));
    return hun;
}
string stoR2 (float &i) {
    string hun;
    SPrintf(hun, "%0.2f =RimWidth/0.0254",((float)i /0.0254f));
    return hun;
}
string tys (float &i) {
    string hun;
    SPrintf(hun, "%0.2f",((float)i /1000));
    return hun;
}
string red (float &i) {
    string line;
    SPrintf(line, "%0.2f",((float)i *9.5493f));
    return line;
}
string inca (float &i) {
    string line;
    SPrintf(line, "%0.1f",(((float)i *5.729578778556937f))*10);
    return line;
}

typedef struct
{
    float X;
    float Y;
    float Z;
} Vector3;

typedef struct
{
    word rX; // 32768 - 180 g
    word rY;
    word rZ;
} Vec3R;

string i2f (int &i) {
    string str;
    SPrintf(str, "%3.3f",((float)i / 65536.0f));
    return str;
}
string rotate (uint &i) {
    string str;
    uint h = i & 2047;
    if(h > 720)
        h -= 2048;

    uint p = (i >> 11) & 2047;
    if(p > 360)
        p -= 1024;

    uint r = (i >> 21);
    if(r > 720)
        r -= 2048;

    SPrintf(str, "h:%3.2f p:%3.2f r:%3.2f", (float)h, (float)p/4.0f, (float)r/4.0f);
    return str;
}

struct Header // 32 bytes
{
    char    FileType[7];    //7
    byte    version; 

};

struct Child // 44
{
    byte Flag<comment = "13 always">;
    byte Type<comment = "00 - main mesh, 01 - calip, 02 - wheel, 03 - normal, 04 - trailing arm, 05 - mudguard, not hide in F mode, 06 - rear df point, 07 - front df point, 08 - undertry df point, 09 - centre df, 0A - mirror, 0B - handlebar",bgcolor=0x933EC5>;
    byte FlipState<comment = "1 - static, 2 - full flip, 3 - swap side">;
    byte LODsCount;
    char Name[20];
    byte SubObjState<comment = "MIRRORED = 1, CUSTOM_COLOR = 2, ALWAYS = 224 (E3 - Mirror only, E2 - Mirror fix possible)">;
    byte unk2;
    byte GroupsCount;
    byte sp;
};

struct RimChild // 44
    {
    char Z[4];
    byte Flag<comment = "13 always">;
    byte Type<comment = "00 - main mesh, 01 - calip, 02 - wheel, 03 - normal, 04 - trailing arm, 05 - mudguard, not hide in F mode, 06 - rear df point, 07 - front df point, 08 - undertry df point, 09 - centre df, 0A - mirror, 0B - handlebar",bgcolor=0x933EC5>;
    byte FlipState<comment = "1 - static, 2 - full flip, 3 - swap side">;
    byte LODsCount;
    char Name[20];
    byte SubObjState<comment = "MIRRORED = 1, CUSTOM_COLOR = 2, ALWAYS = 224 (E3 - Mirror only, E2 - Mirror fix possible)">;
    byte unk2;
    byte GroupsCount;
    byte sp;
};

enum <byte> SUB_OBJ_STATE {
    MIRRORED = 1,
    CUSTOM_COLOR = 2,
    ALWAYS = 224
};

enum <byte> ROTATIONAXIS{
    roll = 0,
    localX = 1,
    pitch = 2,
    localZ = 3,
    heading = 4
};
enum <byte> TRIGGER{
    lights = 0,
    ignition = 1,
    rear_fog = 2,
    front_fog = 3,
    left_ind = 4,
    right_ind = 5,
    extra = 6,
    horn = 7,
    siren = 8
};

struct LODInfo {
    ROTATIONAXIS rott;
    TRIGGER connecto;
    ushort  LODdistance;
};
enum <byte> MIRROR_STATE
{
    MIRROR_OFF = 0,
    MIRROR_ON = 1,
    OLOLO_2 = 2,
    GLASS = 4,
    OLOLO_8 = 8,
    REFERENCED = 16,
    DOUBLE_SIDE = 32

};
enum <byte> LOD
{
    lod0 = 0,
    lod2_shadow = 1,
    lod3_collision = 2

};

struct GeometryInfo{
    word    NumVertex;      //2
    word    NumFaces;       //2
    uint    SubObjectsCount;    //number of child meshes
    Vec3R   rotate;
    word    Zero;
    Vector3 pos;            // position
};


struct ObjectName // 16 byte
{
    byte R; // Red
    byte G; // Green
    byte B; // Blue
    byte X; // N/A
    char Name[10];
};

struct Vertex // size = 16 byte
{
    byte Flag<comment = "0=OFF, 1=MIRROR, 2=FIX_CENTER, 16=REFERENCED, 64=DARK, 128=VERY_DARK, 192=EXT_DARK">;
    byte Bone;
    byte non[2];
    int X<read=i2f>; // 65536 = 1m
    int Y<read=i2f>; // 65536 = 1m
    int Z<read=i2f>; // 65536 = 1m

};

struct Faces // 12 bytes
{
    MIRROR_STATE MirrorState;
    byte LayoutID; // Car Layout ID
    byte MapID;
    byte NCLevel;
    LOD LodID;
    byte GroupID; // 
    u_word Ind1;
    u_word Ind2;
    u_word Ind3;
};



struct Texture // 20 byte
{
    int  Flag<comment = "1 - locate in /skins_dds/CAR_DEFAULT.dds, 2 - dash">;
    char Name[20]<comment = "filename in /data/dds texture name">;
};

