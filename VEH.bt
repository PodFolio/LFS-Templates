#include "SET_veh.bt"

typedef unsigned char byte;
typedef signed short word;
typedef unsigned short u_word;
typedef unsigned int u_int;

local unsigned int ModifiedFlags = 0;
local unsigned int ModifiedTypes = 0;

string sid(byte &s){
    string id;
    SPrintf(id, "%2X", s);
    return id;
}

//local int i; 
string pots (float &i) {
    string pot;
    SPrintf(pot, "%0.14f",((float)i));
    return pot;
}

string angle (ubyte &i) {
    string ang;
    SPrintf(ang, "%0.3f",((float)i *5));
    return ang;
}

string fangle (float &i) {
    string ang;
    SPrintf(ang, "%0.3f",(((float)i *100)/1.7453f));
    return ang;
}

string radius (ubyte &i) {
    string ra;
    SPrintf(ra, "%0.3f",(((float)i/100)/2));
    return ra;
}

string fradius (float &i) {
    string ra;
    SPrintf(ra, "%0.3f",(((float)i+0.313)*100));
    return ra;
}

string fradius2 (float &i) {
    string ra;
    SPrintf(ra, "%0.3f",(((float)i/100)/2));
    return ra;
}

string minusto (ubyte &i) {
    string hun;
    SPrintf(hun, "%0.2f",(((float)i-100) /100));
    return hun;
}

string sto (float &i) {
    string hun;
    SPrintf(hun, "%0.2f",((float)i /100));
    return hun;
}

string sto2 (float &i) {
    string hun;
    SPrintf(hun, "%0.2f",((float)i *1000));
    return hun;
}

string stoR (float &i) {
    string hun;
    SPrintf(hun, "%0.2f =(RimDiamweter*100)/1.27",(((float)i *100)/1.27f));
    return hun;
}

string stoR2 (float &i) {
    string hun;
    SPrintf(hun, "%0.2f =RimWidth/0.0254",((float)i /0.0254f));
    return hun;
}

string tys (float &i) {
    string hun;
    SPrintf(hun, "%0.2f",((float)i /1000));
    return hun;
}

string red (float &i) {
    string line;
    SPrintf(line, "%0.2f",((float)i *9.5493f));
    return line;
}

string inca (float &i) {
    string line;
    SPrintf(line, "%0.1f",(((float)i *5.729578778556937f))*10);
    return line;
}



typedef struct
{
    float X;
    float Y;
    float Z;
} Vector3;

typedef struct
{
    float R;
    float F;
    float U;
} ObjectPos;

typedef struct
{
    word rX; // 32768 - 180 g
    word rY;
    word rZ;
} Vec3R;

string i2f (int &i) {
    string str;
    SPrintf(str, "%3.3f",((float)i / 65536.0f));
    return str;
}

string rotate (uint &i) {
    string str;
    uint h = i & 2047;
    if(h > 720)
        h -= 2048;

    uint p = (i >> 11) & 2047;
    if(p > 360)
        p -= 1024;

    uint r = (i >> 21);
    if(r > 720)
        r -= 2048;

    SPrintf(str, "h:%3.2f p:%3.2f r:%3.2f", (float)h, (float)p/4.0f, (float)r/4.0f);
    return str;
}

struct Header // 32 bytes
{
    char    FileType[7];    //7
    byte    version; 

};

struct Child // 44
{
    byte Flag<comment = "13 always">;
    byte Type<comment = "00 - main mesh, 01 - calip, 02 - wheel, 03 - normal, 04 - trailing arm, 05 - mudguard, not hide in F mode, 06 - rear df point, 07 - front df point, 08 - undertry df point, 09 - centre df, 0A - mirror, 0B - handlebar",bgcolor=0x933EC5>;
    byte FlipState<comment = "1 - static, 2 - full flip, 3 - swap side">;
    byte LODsCount;
    char Name[20];
    byte SubObjState<comment = "MIRRORED = 1, CUSTOM_COLOR = 2, ALWAYS = 224 (E3 - Mirror only, E2 - Mirror fix possible)">;
    byte unk2;
    byte GroupsCount;
    byte sp;
};

struct RimChild // 44
    {
    char Z[4];
    byte Flag<comment = "13 always">;
    byte Type<comment = "00 - main mesh, 01 - calip, 02 - wheel, 03 - normal, 04 - trailing arm, 05 - mudguard, not hide in F mode, 06 - rear df point, 07 - front df point, 08 - undertry df point, 09 - centre df, 0A - mirror, 0B - handlebar",bgcolor=0x933EC5>;
    byte FlipState<comment = "1 - static, 2 - full flip, 3 - swap side">;
