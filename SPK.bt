typedef unsigned char byte;
typedef signed short word;
typedef unsigned short u_word;
typedef unsigned int u_int;


string i2f (int &i) {
    string str;
    SPrintf(str, "%3.3f",((float)i / 65536.0f));
    return str;
}
string rotate (uint &i) {
    string str;
    uint h = i & 2047;
    if(h > 720)
        h -= 2048;

    uint p = (i >> 11) & 2047;
    if(p > 360)
        p -= 1024;

    uint r = (i >> 21);
    if(r > 720)
        r -= 2048;

    SPrintf(str, "h:%3.2f p:%3.2f r:%3.2f", (float)h, (float)p/4.0f, (float)r/4.0f);
    return str;
}

typedef struct
{
    int X;
    int Y;
    int Z;
} Vector3;

typedef struct
{
    word rX; // 32768 - 180 g
    word rY;
    word rZ;
} Vec3R;


struct Header // 32 bytes
{
    char header[7];
    byte version;
};

struct Child // 44
{
    char Z[24];
    ushort Key<format=hex,comment = "E3 - Mirror only, E2 - Mirror fix possible">;
    ubyte Key1<comment = "00 - main mesh, 01 - calip, 02 - wheel, 03 - normal, 06 - rim, 0A - mirror",bgcolor=0x933EC5>;
    ubyte Key2<comment = "01/03 - Mirror fix works, 02 - Mirror fix not work">;
    ubyte Some1Count;
    ubyte unk;
    ushort NaCount;
};
struct Child2 // 44
{
    int unknown<comment = "Do not change">;
};
struct Some1{
    u_word Zero;
    u_word SomeRotate;
};


