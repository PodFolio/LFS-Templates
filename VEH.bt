    struct {
        int R<read=i2f>;
        int F<read=i2f>;
        int U<read=i2f>;
    } locate;
    
    int Width<read=i2f>;
    int Height<read=i2f>;
    ushort CutOutId;
    ushort CutOutIdOpposite;

