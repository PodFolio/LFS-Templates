enum <byte> DriverPosition {
    right = 0,
    left = 1
};
enum <byte> SpeedDisplay {
    mph = 0,
    kmph = 1
};
enum <byte> PressureDisplay {
    bar = 0,
    psi = 1
};
enum <byte> Choice {
    no = 0,
    yes = 1
};
enum <byte> Steering {
    rigid = 0,
    flexible = 1
};

struct Header
{
    char head[6] <bgcolor=0x67D8D8>;
    byte empty;
    byte version <bgcolor=0x9F9FFE ,format=hex>;

};


struct Skins
{
    int color<format=hex>;
    char SkinName[16];
    int zero[8];

};


