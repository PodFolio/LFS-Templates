    unsigned int Full;
};

byte ModifyFormulaType(byte t){
    local unsigned int tt = ModifiedTypes;
    ModifiedTypes = tt | 0x1000;
    if(t == 10){
        ModifiedTypes = tt | 0x7000;
        return 1;
    }
    return 0;
}

void ModifyTypes(byte t){
    if(t == 4){
        if(ModifyFormulaType(t) != 0){
            return;
        }
    }else{
        if((t!=10) && (t != 11)){
            ModifiedTypes = ModifiedTypes | 0x800;
        }
        if(t == 4){
            if(ModifyFormulaType(t) != 0){
                return;
            }            
        }
        if(((t != 11) && (t != 10)) && (t != 6))
        {
            ModifiedTypes = ModifiedTypes | 0x100;
        }
        if((t == 4) || (t == 10))
        {
            if(ModifyFormulaType(t) != 0){
                return;
            }
        }
    }
    if(t != 0){
        ModifiedTypes = ModifiedTypes | 0x8000;
    }
}

struct CarData
{
    VehFlags Flags;
    ModifiedFlags = Flags.Full;
    if((head.version < 0xfc) && (header.SpareWheelDrawHub == 0)){}
    else
    {
        VehTypes Types;
        ModifiedTypes = Types.Full;
    }

    byte Type<comment = "0-object, 1-touring car, 2-saloon, 3-buggy, 4-formula, 5-GT, 6-kart, 7-bike, 8-van, 9-truck, 10-F1, 11-FSAE">;
    byte One2<comment = "always one">;
    byte EditorExportVersion;
    byte needsTransform <comment = "in 0.7f, 0x4315e3 this gets checked and if 1, function is applied on car's memory">;

    if(EditorExportVersion < 7){
        if((ModifiedFlags & 0x20) != 0){
            ModifiedFlags = ModifiedFlags ^ 0x20;
        }
        ModifiedTypes = ModifiedTypes & 0xfffff9ff;
    }

    if(needsTransform < 1){
        ModifyTypes(Type);
    }

    byte Transmission <comment = "0-No, 1-HPat, 2-bike, 3-seq, 4-seqcut, 5-paddle, 6-elec, 7-centrifuge">;
    byte som3_2 <comment = "always below 4">;
    byte Zero<comment = "always zero">;
    byte som3_4<comment = "zero or 1, or lfs will crash">;

    byte DriveType<comment = "0-No Drive, 1-RWD, 2-FWD, 3-AWD,">;
    //byte Electric<comment = "its not it. 0, 1-Electric, 2,3,4,5, 6-Bike?">; //the game does not store this byte at all....
    byte non[3];
    
    if(EditorExportVersion < 4){
        int idk;
    }else{
        int SkinID<format = hex>;
    }
    
    if(4 < EditorExportVersion){
        float skip[4];
    }
    if(5 < EditorExportVersion){
        float sometomg;
    }
    EngFinal eng;

    int setCount;
    Setups defaultSetups[setCount];

    int colCount;
    Colours defaultColours[colCount];
    int defGtrch;

    byte countConfigs;
    byte idk0;//might need at the end of the file
    short _pad;

    if(countConfigs != 0){
        Configs Configuration[countConfigs];
    }

    if(EditorExportVersion >= 7){
        int v;
    }

    ObjectPos _engine;
    ObjectPos _driver;
    if((6 < EditorExportVersion) || ((ModifiedFlags & 0x400) != 0)){
        ObjectPos BackSeat;
    }
    ObjectPos TankBattery;
    ObjectPos Battery12V;
    float Battery12Vmass;

    if((EditorExportVersion < 7) || Battery12Vmass != 0.0f){
        ModifiedFlags = ModifiedFlags | 0x800000;
    }
    ObjectPos spareWheel;

    if(EditorExportVersion < 7){
        float wheelAngle;
    }else{
        float SpareWhellHeading<comment = fangle>;
        float SpareWhellLean<comment = fangle>;
        float some_angles <comment = fangle>;
    }
    
    float SteeringWheelPitch<comment = fangle>;
    float SteeringWheelTurn<comment = fangle>;
    float SteeringWheelHeading<comment = fangle>;

    if((6 < EditorExportVersion) || (ModifiedFlags & 0x4000) != 0){
        float TrailReductionH;
    }

    if((EditorExportVersion < 6) && (ModifiedFlags & 0x80000) != 0){
        float TrailReductionH;
    }

    float sssome4[3];
    int mustSkip;
    
    if((mustSkip != 0) && (EditorExportVersion < 6)){
        byte ThisMustBeSkipped[8];
    }

    byte dasztype;
    byte daszsize;
    byte daszFlag;
    byte next2;
    byte daszboard[daszsize];
    
    if(EditorExportVersion < 4){
        int unk1wn;
        int unk0wn;
        int SkinID<format = hex>;
    }

    byte som67[8]; //yea, hate me

    int NrForwardGears;
    float ReverseGearRatio;

    char cartype[8];
    if(EditorExportVersion >= 3){
        char EngineSoundFile[32];
    }

    local int param13 = ((6 < EditorExportVersion) - 1 & 0xfffffffd) + 0xb;
    int LightColour[param13]<format=hex>;
    
    char FrmName[4];
    Frame frm;

    if(EditorExportVersion >= 5){
        float SuspMassConstant;
    }
    int whlCount;    

    Wh wh[whlCount];
    Wheels Rear;
    Wheels Front;
};

Header head;
CarData data;
struct {
    Child Chld  <bgcolor=cRed>;

    struct  LODInfo lodinf[Chld.LODsCount];

    struct GeometryInfo Geometry;
    struct Vertex Vert[Geometry.NumVertex];
