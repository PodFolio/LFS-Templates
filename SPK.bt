struct CutOut
{
    char name[16];
    byte rotate; // bitwise 1 - rotate 90, 2- rotate 180, 3 - rotate 270,  4 - flip
    byte Flag;
    ushort PageId;
    byte AlphaType; // 0 - solid, 1 - Alpha test, 3 - Alpha, 4 - Tree edge alpha
    byte EnvMapType; // 0 - matt, 1 - constant shine, 2 - var shine, 3 - overlay or plain
    byte ShineType; // 0 - none, 1 - paint, 2 - glass, 3 - metall, 4 - water, 5 - asphalt, 6 - rubber, 7 - plastic
    byte Sp;
    struct {
        byte R;
        byte G;
        byte B;
    } ReflectionColor;
    byte Roughness; // 100 = 1.0
    byte sizeX; // 128 = 100%
    byte sizeY; // 128 = 100%
    byte posX; // 128 = 100%
    byte posY; // 128 = 100%
};

struct Material // 44 byte
{
    char name[16];
    struct {
        byte R;
        byte G;
        byte B;
    } Color;
    byte Sp;
    int  Flag; // bitwise 0-no, 1-central 16 - link to top
    // step 0.25 
    // heading = step
    // pitch = step >> 11
    // roll = step >> 21
    uint  rotate<read=rotate>; // heading + pitch + roll

    struct {
        int R<read=i2f>;
        int F<read=i2f>;
        int U<read=i2f>;
    } locate;
    
    int Width<read=i2f>;
    int Height<read=i2f>;
    ushort CutOutId;
    ushort CutOutIdOpposite;
};





