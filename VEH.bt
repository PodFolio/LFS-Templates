struct Dashboard {

        byte DashType<comment="1: s_clock, 2:s_clock_white 3: s_clock_formula">;
        byte size;
        byte e[2];
        if (size > 0)
        {
            byte LCD <bgcolor=0x9FAFFF,comment="0: Gear:led RPM:led, 1: Gear:led RPM:led, 2: Gear:led RPM:led, 3 gear diode, 4: Gear:led RPM:diode, 5: Gear:diode RPM:diode 7: rpm led, 47:s_clock gear:on, rpm:on 82: s_clock Gear OFF">;
            byte SpeedoDigital<comment="0: Analog, 1:Oil temp ON, 2: Oil pressure ON, 3: Oil temp/pressuer ON, 4: Digital">;
            byte un[2];
            if (DashType == 3)
            {
                if (LCD == 0 || LCD == 1 || LCD == 2)
                {
                    RPMled Tacho;
               
                }
                else
                {
                    RPMdiode Tacho;
               
                }
            }
            else if (DashType == 1)
            {
                if (LCD == 58)
                {
                    byte MFDisp<comment="0: Off, 1: vws, 2: 123 3: digi 123">;
                    byte emp2;
                    byte emp3;
                    byte emp4;
                    int emp;
                    Indicator unknn;
                    //SpeedoAnalog Tacho;
                }
                
                
            }

            else
            {
                    byte MFDisp<comment="0: Off, 1: vws, 2: 123 3: digi 123">;
                    byte empt2;
                    byte empt3;
                    byte empt4;
               
            }
        DColor MFDcol1;
        DColor MFDcol2;    
        Indicator ShiftLight;
        Indicator FullBeam;
        Indicator Handbrake;
        Indicator PitLimiter;
        Indicator TractionControl;
        Indicator LeftIndicator;
        Indicator RightIndicator;
        Indicator SharedIndicator;
        Indicator OilPresure;
        Indicator Battery;
        Indicator ABS;
        Indicator un3;
        Dash Sometin;
        Dash Gear;
        if (size !=80)
        {
        Dash MultiFunctionDisp;
        Dash BR_SpeedoDig;
        }
        if (DashType == 1 || DashType == 2)
        {
            if ((LCD == 0 && SpeedoDigital == 0))
            {
                Dash som;
                Dash2 Speedo;
                Dash2 Tacho;
                Dash2 FPS;
                Dash2 TimeClock;
                Dash2 WaterTemp;
                Dash2 Fuel;
                Dash2 OilTemp;
                Dash2 OilPressure;
                
            }
            else if (LCD == 0 && SpeedoDigital == 4)
            {
                Dash SpeedoDig;
                Dash2 Somee;
                Dash2 Tacho;
                Dash2 FPS;
                Dash2 TimeClock;
                Dash2 WaterTemp;
                Dash2 Fuel;
                Dash2 OilTemp;
                Dash2 OilPressure;
                //Indicator un4;
            }
            else
            {
                Dash2 Speedo;
                Dash2 Tacho;
                Dash2 FPS;
                Dash2 TimeClock;
                Dash2 WaterTemp;
                Dash2 Fuel;
                Dash2 OilTemp;
                if (size ==144)
                {
                    
                    Dash2 OilPressure;
                    Indicator unknn2;
                }
                else if (size ==160)
                {
                    
                    Dash2 OilPressure;
                    Indicator unknn2;
                    Dash2 unknn3;
                    Dash2 unknn4;
                }
            }
        }
        
    }   
};
